            "uvr_mdx23c_instvoc_hq",
            "uvr_mdxnet_voc_ft",
            "uvr_mdxnet_main",
            "uvr_mdxnet_inst_hq_1",
            "uvr_mdxnet_inst_hq_2",
            "uvr_mdxnet_inst_hq_3",
            "uvr_mdxnet_inst_hq_4",
            "uvr_mdxnet_inst_hq_5",
            "scnet_xl_ihf",
            "scnet_xl",
            "scnet_masked_xl_ihf",
            "scnet_large",
            "scnet_large_zfturbo",
            "scnet_small",
            "htdemucs",
            "htdemucs_ft",
            "bs_roformer_zfturbo_4stem",
            "mdx23c_zfturbo_4stem",
            "mdxnet_kuielab_a",
            "mdxnet_kuielab_b",
            "bs_roformer_sw_6stem"
          ]
        },
        "fallback_model": {
          "type": "string",
          "enum": [
            "none",
            "mel_roformer_kim_vocals",
            "bs_roformer_viperx_vocals",
            "bs_polarformer_vocals",
            "mel_roformer_viperx_vocals",
            "mdx23c_vocals_zfturbo",
            "uvr_mdx23c_instvoc_hq",
            "uvr_mdxnet_voc_ft",
            "uvr_mdxnet_main",
            "uvr_mdxnet_inst_hq_1",
            "uvr_mdxnet_inst_hq_2",
            "uvr_mdxnet_inst_hq_3",
            "uvr_mdxnet_inst_hq_4",
            "uvr_mdxnet_inst_hq_5",
            "scnet_xl_ihf",
            "scnet_xl",
