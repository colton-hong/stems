{
  "version": 1,
  "title": "Clef-omni against BEATs on MoisesDB: pre-registration",
  "created": "2026-11-23",
  "source": "docs/research-report.pdf, section 5, with docs/corrections.md",
  "dataset": {
    "name": "moisesdb_subset",
    "frozen_list": "moisesdb_subset.json",
    "frozen_sha256": "4a5dfd20b191282dc68ffd6d2f24e3f8b80ca16ab913f5d308820267ebdc2035"
  },
  "seed": 2307,
  "excerpt": {
    "rule": "the loudest window of the mix by RMS; the same window for the mix and every stem of the track",
    "seconds": 30.0,
    "grid_seconds": 1.0
  },
  "presence_rule": {
    "rule": "a stem is present if its RMS over the excerpt is at least rms_dbfs_min and it is non-silent for at least sounding_seconds_min",
    "rms_dbfs_min": -40.0,
    "sounding_seconds_min": 5.0,
    "silence_dbfs": -60.0,
    "silence_window_seconds": 0.1
  },
  "clip_format": {
    "sample_rate_hz": 16000,
    "channels": 1,
    "encoding": "WAV, 16-bit PCM; turned down only if it would clip",
    "max_bytes": 8388608
  },
  "class_to_stem": {
    "file": "models/listening/audioset_stem_map.yaml",
    "version": 1,
    "sha256": "eedb78785e3fefd60c5b7dd4fcb05b0734115b997ff2c88ce67c17499f8a64d9",
    "labels_sha256": "cdd1049833c4b86127c2773ac0d14a2754b6a6d0d1798002ed5c66e699708429"
  },
  "clef_omni": {
    "model": "@cf/cloudflare/clef-omni",
    "present_threshold": 0.5,
    "presence_questions": {
      "type": "noul",
      "per_stem": {
        "vocals": "Are vocals (singing, rapping or speech) audible in this clip?",
        "drums": "Are drums audible in this clip?",
        "bass": "Is a bass instrument (bass guitar, double bass or synth bass) audible in this clip?",
        "guitar": "Is a guitar audible in this clip?",
        "piano": "Is a piano audible in this clip?",
        "other": "Is any instrument other than vocals, drums, bass, guitar and piano audible in this clip?"
      }
    },
    "bleed_question": {
      "type": "noul",
      "text": "Is any instrument other than {target} audible?"
    },
    "bleed_score": {
      "type": "score",
      "text": "This clip should contain only {target}. How much of another instrument is audible?",
      "legend": [
        "Clean — only the named instrument is audible",
        "Faint bleed — another instrument is just audible",
        "Audible bleed — another instrument is clearly audible",
        "Heavy bleed — another instrument is prominent"
      ]
    },
    "lead_backing": {
      "type": "choice",
      "text": "Which vocals are audible in this clip?",
      "options": [
        "lead only",
        "backing only",
        "both",
        "neither"
      ],
      "asked_on": "the isolated vocals stem of each lead_backing track"
    },
    "reverb": {
      "type": "noul",
      "text": "Is there audible reverberation on {target} in this clip?"
    },
    "target_names": {
      "vocals": "vocals",
      "drums": "drums",
      "bass": "the bass",
      "guitar": "the guitar",
      "piano": "the piano",
      "other": "the named instrument"
    }
  },
  "beats": {
    "windows": "three consecutive 10-second windows of the excerpt; class probabilities are averaged over them",
    "stem_score": "the largest probability among the stem's classes",
    "present_threshold": 0.5,
    "secondary": "also reported at the threshold with the best F1, labelled as chosen after the fact",
    "bleed_score": "the largest probability among the classes of every stem other than the target"
  },
  "bleed_levels": {
    "clean": 0,
    "+30 dB SIR": 1,
    "+20 dB SIR": 2,
    "+12 dB SIR": 3,
    "+6 dB SIR": 4
  },
  "reverb_wet_db": -12.0,
  "thresholds": {
    "A1": {
      "what": "presence accuracy over every mix decision (tracks x 6 stems)",
      "min_accuracy": 0.85
    },
    "A2": {
      "what": "presence accuracy per stem",
      "min_accuracy": {
        "vocals": 0.8,
        "drums": 0.8,
        "bass": 0.8,
        "guitar": 0.8,
        "piano": 0.8,
        "other": 0.7
      }
    },
    "A3": {
      "what": "vocals present or absent",
      "min_accuracy": 0.9
    },
    "B1": {
      "what": "clean against bleed, by the probability of the 'any other instrument' question, as area under the ROC curve",
      "min_auc_pooled": 0.85,
      "min_auc_hardest": 0.8,
      "hardest_sir_db": 30.0
    },
    "B2": {
      "what": "Spearman correlation between the bleed score and the true bleed level (clean 0, +30 dB 1, +20 dB 2, +12 dB 3, +6 dB 4)",
      "min_spearman": 0.7
    },
    "B3": {
      "what": "share of clean clips called bleeding: score at or above 1, or the 'any other instrument' probability at or above 0.5",
      "max_false_positive_rate": 0.1
    },
    "C": {
      "what": "Clef-omni's margin over BEATs on A1 (accuracy) and B1 (pooled AUC), in percentage points, on the same clips",
      "min_margin_points": 5.0
    }
  },
  "decision_rule": "Clef-omni passes for quality gating only if A1, A2, A3, B1, B2 and B3 all hold, and is preferred over BEATs only if C also holds on both A1 and B1. If it fails any of B1 to B3 but passes A1 to A3 it may be used for presence and routing only, never for gating. Otherwise BEATs is used, with CLAP as a second opinion.",
  "logging": "every request and response is appended to a JSONL log with question ids, probabilities and token usage; the log header carries this file's commit",
  "counts": {
    "tracks": 50,
    "mix_decisions": 300,
    "present": {
      "vocals": 44,
      "drums": 48,
      "bass": 48,
      "guitar": 45,
      "piano": 14,
      "other": 24
    },
    "absent": {
      "vocals": 6,
      "drums": 2,
      "bass": 2,
      "guitar": 5,
      "piano": 36,
      "other": 26
    },
    "lead_backing_clips": 23,
    "lead_backing_answers": {
      "lead only": 1,
      "backing only": 1,
      "both": 18,
      "neither": 3
    },
    "part_b_clean": 20,
    "part_b_bleed": 80,
    "part_b_targets": {
      "vocals": 5,
      "drums": 5,
      "bass": 5,
      "guitar": 3,
      "piano": 2
    },
    "reverb_clips": 5
  },
  "notes": [
    "The report asks for at least 8 instrumental tracks among the 50. MoisesDB has one track without vocals in 240, so the frozen subset has one (docs/corrections.md, C15).",
    "As a result A3 rests on few negatives: vocals are absent from 6 of 50 excerpts by the presence rule. A3 is still scored against its threshold as written; the report also gives the counts, and the accuracy of always answering 'present', so the reader can see how much A3 can show.",
    "Part B's five guitar-or-piano stems are taken as guitar, piano, guitar, piano, guitar. The reverb probe uses Part B's clean vocal stems.",
    "The lead-or-backing sub-test and the reverb probe are exploratory and are not part of the pass decision."
  ],
  "cannot_show": [
    "anything above 8 kHz: both models hear 16 kHz audio",
    "stereo bleed: the clips are mono",
    "differences of a point or two between the models: 300 decisions give about 4 points of precision on A1, hence the 5-point margin in C"
  ],
