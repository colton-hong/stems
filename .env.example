# Copy to .env and fill in. Never commit .env. Nothing here is required for local use:
# without keys the system uses rule-based fallbacks, local storage and the local worker.

# --- Decision layer (Phase 4). Unset = rule-based fallback only.
TYPESAFE_API_KEY=

# --- Clef-omni test (Phase 3 only).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=

# --- Datasets (Phase 2-3). Absolute paths to local copies you obtained yourself.
MUSDB18HQ_PATH=
MOISESDB_PATH=

# --- Model weights cache. Default: ./models/weights
STEMS_MODELS_DIR=

# --- GPU worker provider (Phase 5): local | modal
STEMS_WORKER_PROVIDER=local
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Storage (Phase 5): local | s3 | azure_blob
STEMS_STORAGE_BACKEND=local
STEMS_STORAGE_LOCAL_DIR=
# Signs local download links and owner cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
STEMS_SIGNING_SECRET=
S3_ENDPOINT_URL=
S3_BUCKET=
# AWS itself needs a region; other S3-compatible services usually do not.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# --- API (Phase 5)
STEMS_DATABASE_URL=sqlite:///./runs/dev/stems.db
STEMS_WEB_ORIGIN=http://localhost:3000

# --- Web (Phase 6)
NEXT_PUBLIC_API_URL=http://localhost:8000
